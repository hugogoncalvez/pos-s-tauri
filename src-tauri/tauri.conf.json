{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POS-System",
  "version": "0.1.0",
  "identifier": "com.hugogoncalvez.possystem",
  "build": {
    "frontendDist": "../front/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir front dev",
    "beforeBuildCommand": "pnpm --dir front build"
  },
  "app": {
    "enableGTKAppId": true,
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "id": "main"
    },
    "windows": [
      {
        "title": "POS-S",
        "width": 1366,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "closable": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "main.desktop"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}